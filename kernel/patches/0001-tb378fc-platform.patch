 	struct device *iommu_dev;
+	struct iommu_resv_region *region;
+	LIST_HEAD(regions);
+	u64 va_start = 0x1000, va_size = 0, cursor = 0x1000;
+	const u64 va_limit = 0x100000000ULL;
 
 	/*
 	 * IOMMUs can be a part of MDSS device tree binding, or the
@@ -203,8 +207,45 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
-	vm = msm_gem_vm_create(dev, mmu, "mdp_kms",
-			       0x1000, 0x100000000 - 0x1000, true);
+	/* TB378FC_LARGEST_FREE_IOVA: reservations need not be sorted.
+	 * Keep both the MSI window and inherited scanout outside the allocator.
+	 * Truncating at the first reservation left only 128 MiB on TB378FC.
+	 */
+	iommu_get_resv_regions(iommu_dev, &regions);
+	while (cursor < va_limit) {
+		u64 next = va_limit, blocked_end = cursor;
+
+		list_for_each_entry(region, &regions, list) {
+			u64 end;
+
+			if (!region->length || region->start >= va_limit)
+				continue;
+			end = region->start + min_t(u64, region->length,
+						va_limit - region->start);
+			if (end <= cursor)
+				continue;
+			if (region->start <= cursor)
+				blocked_end = max(blocked_end, end);
+			else
+				next = min_t(u64, next, region->start);
+		}
+		if (blocked_end > cursor) {
+			cursor = blocked_end;
+			continue;
+		}
+		if (next - cursor > va_size) {
+			va_start = cursor;
+			va_size = next - cursor;
+		}
+		cursor = next;
+	}
+	iommu_put_resv_regions(iommu_dev, &regions);
+	if (!va_size) {
+		mmu->funcs->destroy(mmu);
+		return ERR_PTR(-ENOSPC);
+	}
+	drm_info(dev, "KMS IOVA aperture %#llx+%#llx\n", va_start, va_size);
+	vm = msm_gem_vm_create(dev, mmu, "mdp_kms", va_start, va_size, true);
 	if (IS_ERR(vm)) {
 		dev_err(mdp_dev, "vm create, error %pe\n", vm);
 		mmu->funcs->destroy(mmu);
