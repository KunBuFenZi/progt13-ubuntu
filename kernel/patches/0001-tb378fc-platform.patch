--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc-wifi.dts
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* TB378FC WCN7860 bring-up: native supply/gpio mapping checked by generator.
+ * Firmware/board-data selection and Wi-Fi operation are not yet verified.
+ */
+#include "sm8750-lenovo-tb378fc-gpu.dts"
+
+/ {
+	wcn7860-pmu {
+		compatible = "qcom,wcn7860-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_wlan_en>, <&tb378fc_bt_enable>;
+
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&vreg_l3f_1p8>;
+		vddio1p2-supply = <&vreg_l2f_1p2>;
+		vddaon-supply = <&vreg_s4d_0p85>;
+		vdddig-supply = <&vreg_s5f_0p85>;
+		vddrfa1p2-supply = <&vreg_s7i>;
+		vddrfa1p8-supply = <&vreg_s3g>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+};
+
+&apps_rsc {
+    regulators-d {
+        vdd-s4-supply = <&vph_pwr>;
+        vreg_s4d_0p85: smps4 {
+            regulator-name = "tb378fc-wlan-aon";
+            regulator-min-microvolt = <852000>;
+            regulator-max-microvolt = <1036000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+        };
+    };
+    regulators-f {
+        compatible = "qcom,pm8550ve-rpmh-regulators";
+        qcom,pmic-id = "f";
+        vdd-l1-supply = <&vreg_s1d>;
+        vdd-l2-supply = <&vreg_s7i>;
+        vdd-l3-supply = <&vreg_s3g>;
+        vdd-s5-supply = <&vph_pwr>;
+        vreg_s5f_0p85: smps5 {
+            regulator-name = "tb378fc-wlan-dig";
+            regulator-min-microvolt = <852000>;
+            regulator-max-microvolt = <1000000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+        };
+        vreg_l1f_0p88: ldo1 {
+            regulator-name = "tb378fc-pcie-phy";
+            regulator-min-microvolt = <880000>;
+            regulator-max-microvolt = <920000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+        };
+        vreg_l2f_1p2: ldo2 {
+            regulator-name = "tb378fc-wlan-io12";
+            regulator-min-microvolt = <1200000>;
+            regulator-max-microvolt = <1200000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+        };
+        vreg_l3f_1p8: ldo3 {
+            regulator-name = "tb378fc-wlan-io";
+            regulator-min-microvolt = <1800000>;
+            regulator-max-microvolt = <1800000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+        };
+    };
+};
+
+&tlmm {
+    tb378fc_wlan_en: wlan-enable-state {
+        pins = "gpio16";
+        function = "gpio";
+        drive-strength = <16>;
+        bias-pull-up;
+    };
+};
+
+&pm8550ve_f_gpios {
+    tb378fc_bt_enable: bt-enable-state {
+        pins = "gpio3";
+        function = "normal";
+        power-source = <1>;
+        bias-disable;
+        input-disable;
+        output-enable;
+    };
+};
+
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1f_0p88>;
+	vdda-pll-supply = <&vreg_l3g>;
+
+	status = "okay";
+};
+
+&pcieport0 {
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+
+	wifi@0 {
+		compatible = "pci17cb,110e";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts
new file mode 100644
index 000000000..a38cc0a30
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Lenovo TB378FC, stage 1: RAM userspace and USB2 peripheral diagnostics.
+ * USB rail assignments and constraints are from this unit's running DT.
+ * The SM8750 common DTS and PMIC descriptions provide the platform blocks.
+ */
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8750.dtsi"
+#include "pm8550.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pmih0108.dtsi"
+#include "pmk8550.dtsi"
+#include "sm8750-pmics.dtsi"
+
+/ {
+	model = "Lenovo Xiaoxin Pad Pro GT 13 (TB378FC, RAM diagnostics)";
+	compatible = "lenovo,tb378fc", "qcom,sm8750";
+	chassis-type = "tablet";
+
+	/* Lenovo ABL updates this existing node before entering the kernel. */
+	chosen {
+	};
+
+	reserved-memory {
+		/* Preserve the UEFI scanout for the temporary screen console. */
+		splash_region {
+			label = "cont_splash_region";
+			reg = <0x0 0xfc800000 0x0 0x2b00000>;
+			no-map;
+		};
+
+		/* Match this unit's downstream 4 MiB RAM console allocation. */
+		ramoops@c2000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xc2000000 0x0 0x400000>;
+			console-size = <0x200000>;
+			pmsg-size = <0x200000>;
+			record-size = <0>;
+			no-map;
+		};
+	};
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <76800000>;
+			#clock-cells = <0>;
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		bi_tcxo_div2: bi-tcxo-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+
+		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+/* The unit reserves the full first 18 MiB for the hypervisor. */
+&gunyah_hyp_mem {
+	reg = <0x0 0x80000000 0x0 0x1200000>;
+};
+/delete-node/ &cpusys_vm_mem;
+
+/* Preserve UEFI scanout until the native DSI/panel chain is ready.
+ * The DISPCC probe reprograms PLL0/1/2 even when DRM is disabled.
+ */
+&dispcc {
+	status = "disabled";
+};
+
+&tlmm {
+	/* Live DT qcom,gpios-reserved: 36, 37, 38, 39, 74.
+	 * Exclude these from GPIO registration's get_direction() scan.
+	 */
+	gpio-reserved-ranges = <36 4>, <74 1>;
+};
+
+&apps_rsc {
+	regulators-b {
+		compatible = "qcom,pm8550-rpmh-regulators";
+		qcom,pmic-id = "b";
+		vdd-bob1-supply = <&vph_pwr>;
+		vdd-l5-l16-supply = <&vreg_bob1>;
+		vdd-l15-supply = <&vreg_s3g>;
+
+		vreg_bob1: bob1 {
+			regulator-name = "vreg_bob1";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <4000000>;
+		};
+		vreg_l5b: ldo5 {
+			regulator-name = "vreg_l5b_usb_repeater";
+			regulator-min-microvolt = <3100000>;
+			regulator-max-microvolt = <3148000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+		vreg_l15b: ldo15 {
+			regulator-name = "vreg_l15b_usb_repeater";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-d {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "d";
+		vdd-s1-supply = <&vph_pwr>;
+		vdd-l2-supply = <&vreg_s1d>;
+
+		vreg_s1d: smps1 {
+			regulator-name = "vreg_s1d";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <1100000>;
+		};
+		vreg_l2d: ldo2 {
+			regulator-name = "vreg_l2d_usb_hsphy";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <912000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-g {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "g";
+		vdd-s3-supply = <&vph_pwr>;
+		/* PM8550VE L3 input follows the SM8750 reference supply topology. */
+		vdd-l3-supply = <&vreg_s7i>;
+
+		vreg_s3g: smps3 {
+			regulator-name = "vreg_s3g";
+			regulator-min-microvolt = <1856000>;
+			regulator-max-microvolt = <2000000>;
+		};
+		vreg_l3g: ldo3 {
+			regulator-name = "vreg_l3g_usb_hsphy";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1256000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-i {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "i";
+		vdd-s7-supply = <&vph_pwr>;
+
+		vreg_s7i: smps7 {
+			regulator-name = "vreg_s7i_usb_supply";
+			regulator-min-microvolt = <1224000>;
+			regulator-max-microvolt = <1340000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+&pmih0108_eusb2_repeater {
+	vdd18-supply = <&vreg_l15b>;
+	vdd3-supply = <&vreg_l5b>;
+	status = "okay";
+};
+
+&usb_hsphy {
+	vdd-supply = <&vreg_l2d>;
+	vdda12-supply = <&vreg_l3g>;
+	phys = <&pmih0108_eusb2_repeater>;
+	status = "okay";
+};
+
+/* Fixed USB2 peripheral mode avoids depending on ADSP/UCSI for first boot. */
+&usb {
+	/delete-property/ usb-role-switch;
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_hsphy>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
+
+&usb_dwc3_ss {
+	/delete-property/ remote-endpoint;
+};
+
+&usb_dp_qmpphy_usb_ss_in {
+	/delete-property/ remote-endpoint;
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
diff --git a/drivers/firmware/efi/tb378fc-earlyfb.inc b/drivers/firmware/efi/tb378fc-earlyfb.inc
new file mode 100644
index 000000000..d59f595c2
--- /dev/null
+++ b/drivers/firmware/efi/tb378fc-earlyfb.inc
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by EFI earlycon to reuse its mapping and bitmap-font helpers.
+ * This is a temporary inherited-scanout console, not a native panel driver.
+ */
+#include <asm/sysreg.h>
+#include <generated/utsrelease.h>
+
+static unsigned int tb378fb_scale, tb378fb_log_top;
+static unsigned int tb378fb_rows, tb378fb_hold_row;
+static bool tb378fb_held;
+
+static void tb378fb_scaled_char(u32 *dst, unsigned char c, unsigned int h)
+{
+	unsigned int x, repeat, bytes = BITS_TO_BYTES(font->width);
+	const u8 *src = font->data + c * font->height * bytes +
+		(h / tb378fb_scale) * bytes;
+
+	for (x = 0; x < font->width; x++) {
+		u32 color = src[x / 8] & (0x80 >> (x % 8)) ? 0x00ffffff : 0;
+
+		for (repeat = 0; repeat < tb378fb_scale; repeat++)
+			*dst++ = color;
+	}
+}
+
+static void tb378fb_hold(void)
+{
+	u64 freq = read_sysreg(cntfrq_el0);
+	u64 end;
+
+	/* Use the architectural timer: delay calibration has not run yet. */
+	if (!freq || freq > 1000000000)
+		return;
+	isb();
+	end = read_sysreg(cntvct_el0) + freq * 8;
+	while ((s64)(read_sysreg(cntvct_el0) - end) < 0)
+		cpu_relax();
+}
+
+static void tb378fb_write(struct console *con, const char *str, unsigned int num)
+{
+	const struct screen_info *si = &sysfb_primary_display.screen;
+	u32 stride = si->lfb_linelength;
+	u32 char_width = font->width * tb378fb_scale;
+	u32 char_height = font->height * tb378fb_scale;
+	unsigned int count, h, n;
+	void *dst;
+
+	while (num) {
+		count = min_t(unsigned int, strnchrnul(str, num, '\n') - str,
+				(si->lfb_width - efi_x) / char_width);
+		for (h = 0; h < char_height; h++) {
+			dst = efi_earlycon_map((efi_y + h) * stride, stride);
+			if (!dst)
+				return;
+			if (!efi_x)
+				memset(dst, 0, stride);
+			for (n = 0; n < count; n++)
+				tb378fb_scaled_char(dst + (efi_x + n * char_width) * 4,
+						    (unsigned char)str[n], h);
+			efi_earlycon_unmap(dst, stride);
+		}
+		str += count;
+		num -= count;
+		efi_x += count * char_width;
+		if ((num && *str == '\n') || efi_x + char_width > si->lfb_width) {
+			if (num && *str == '\n') {
+				str++;
+				num--;
+			}
+			efi_x = 0;
+			efi_y += char_height;
+			/* Circular rows avoid copying a 31 MB framebuffer per message. */
+			if (efi_y + char_height > si->lfb_height)
+				efi_y = tb378fb_log_top;
+			tb378fb_rows++;
+			if (tb378fb_hold_row && !tb378fb_held &&
+			    tb378fb_rows >= tb378fb_hold_row) {
+				tb378fb_held = true;
+				tb378fb_write(con, "\n[HOLD] Paused for 8 seconds.\n",
+					       sizeof("\n[HOLD] Paused for 8 seconds.\n") - 1);
+				tb378fb_hold();
+			}
+		}
+	}
+}
+
+static int __init tb378fb_setup(struct earlycon_device *device, const char *options)
+{
+	struct screen_info *si = &sysfb_primary_display.screen;
+	bool qemu = options && !strncmp(options, "qemu", 4);
+	const char *opt = options;
+
+	if (qemu) {
+		opt += 4;
+		if (*opt == '-')
+			opt++;
+	}
+	if (opt && *opt) {
+		if (strncmp(opt, "hold", 4) || kstrtouint(opt + 4, 10, &tb378fb_hold_row) ||
+		    !tb378fb_hold_row || tb378fb_hold_row > 4096)
+			return -EINVAL;
+	}
+	fb_base = qemu ? 0x60000000 : 0xfc800000;
+	si->orig_video_isVGA = VIDEO_TYPE_EFI;
+	si->lfb_base = fb_base;
+	si->ext_lfb_base = 0;
+	si->lfb_width = qemu ? 1024 : 3504;
+	si->lfb_height = qemu ? 768 : 2190;
+	si->lfb_depth = 32;
+	si->lfb_linelength = si->lfb_width * 4;
+	si->lfb_size = si->lfb_linelength * si->lfb_height;
+	si->red_size = si->green_size = si->blue_size = 8;
+	si->red_pos = 16;
+	si->green_pos = 8;
+	si->blue_pos = 0;
+	fb_wb = false;
+	font = get_default_font(si->lfb_width, si->lfb_height, NULL, NULL);
+	if (!font)
+		return -ENODEV;
+	tb378fb_scale = qemu ? 2 : 4;
+	efi_x = 0;
+	efi_y = 0;
+	tb378fb_held = true;
+	tb378fb_write(device->con, "TB378FC MAINLINE " UTS_RELEASE "\n",
+		       sizeof("TB378FC MAINLINE " UTS_RELEASE "\n") - 1);
+	tb378fb_write(device->con, "Large text / one 8-second hold\n",
+		       sizeof("Large text / one 8-second hold\n") - 1);
+	tb378fb_log_top = efi_y;
+	tb378fb_rows = 0;
+	tb378fb_held = false;
+	device->con->write = tb378fb_write;
+	earlycon_console = device->con;
+	return 0;
+}
+EARLYCON_DECLARE(tb378fb, tb378fb_setup);
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36526.c b/drivers/gpu/drm/panel/panel-novatek-nt36526.c
new file mode 100644
index 000000000..4d695c863
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36526.c
@@ -0,0 +1,383 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Lenovo TB378FC / CSOT NT36526 dual-DSI panel driver
+ * Board timing and command data extracted from this unit's live DT.
+ * Common dual-DSI glue from Erwin's pinned NT36536 driver.
+ * Copyright (c) 2026, Erwin
+ *
+ * Dual-DSI handling based on panel-himax-hx83121a.c
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct novatek_nt36526 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi[2];
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vddio;
+	struct regulator *bias;
+};
+
+static inline struct novatek_nt36526 *to_novatek_nt36526(struct drm_panel *panel)
+{
+	return container_of(panel, struct novatek_nt36526, panel);
+}
+
+static void novatek_nt36526_reset(struct novatek_nt36526 *ctx)
+{
+	/* Native physical levels: 0/11ms, 1/1ms, 0/3ms, 1/10ms.
+	 * The reset descriptor is active-low, so logical 1 asserts reset.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(11);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(3000, 3500);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(10);
+}
+
+/* Packet types and delays are preserved, including long writes with
+ * two-byte payloads. The standard DCS helper would shorten those packets.
+ */
+struct tb378fc_panel_cmd {
+	u8 type;
+	u8 len;
+	u16 wait_ms;
+	u8 data[17];
+};
+
+static const struct tb378fc_panel_cmd tb378fc_on[] = {
+	{ 0x39, 2, 0, { 0xff, 0x20 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0x78, 0xd3 } },
+	{ 0x39, 2, 0, { 0xff, 0x26 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0x93, 0xf4 } },
+	{ 0x39, 2, 0, { 0x94, 0xee } },
+	{ 0x39, 5, 0, { 0x9a, 0x26, 0x4c, 0x26, 0x26 } },
+	{ 0x39, 5, 0, { 0x9b, 0x0f, 0x0f, 0x0f, 0x0f } },
+	{ 0x39, 5, 0, { 0x9c, 0xad, 0x2c, 0xad, 0xad } },
+	{ 0x39, 5, 0, { 0x9d, 0x10, 0x0f, 0x10, 0x10 } },
+	{ 0x39, 5, 0, { 0x9e, 0x19, 0x98, 0x19, 0x19 } },
+	{ 0x39, 2, 0, { 0xff, 0x23 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0x89, 0xa4 } },
+	{ 0x39, 2, 0, { 0xff, 0xe0 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0xbb, 0x00 } },
+	{ 0x39, 2, 0, { 0xff, 0xf0 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0xe6, 0x02 } },
+	{ 0x39, 2, 0, { 0xff, 0x27 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0xd0, 0x33 } },
+	{ 0x39, 2, 0, { 0xd1, 0x05 } },
+	{ 0x39, 2, 0, { 0xde, 0x41 } },
+	{ 0x39, 2, 0, { 0xdf, 0x00 } },
+	{ 0x39, 2, 0, { 0xff, 0x25 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 2, 0, { 0x19, 0x1f } },
+	{ 0x39, 2, 0, { 0x1c, 0x10 } },
+	{ 0x39, 2, 0, { 0xff, 0x10 } },
+	{ 0x39, 2, 0, { 0xfb, 0x01 } },
+	{ 0x39, 10, 0, { 0x3b, 0x03, 0xe0, 0x1a, 0x04, 0x04, 0x00, 0x80, 0x36, 0xa1 } },
+	{ 0x39, 2, 0, { 0x60, 0x00 } },
+	{ 0x39, 3, 0, { 0x90, 0x03, 0x00 } },
+	{ 0x39, 17, 0, { 0x91, 0xab, 0xa8, 0x00, 0x1e, 0xd2, 0x00, 0x00, 0x00, 0x03, 0x68, 0x00, 0x0c, 0x03, 0x97, 0x02, 0x17 } },
+	{ 0x39, 3, 0, { 0x92, 0x10, 0xf0 } },
+	{ 0x39, 3, 0, { 0xb2, 0x91, 0x80 } },
+	{ 0x39, 2, 0, { 0xb3, 0x40 } },
+	{ 0x05, 1, 120, { 0x11 } },
+	{ 0x05, 1, 20, { 0x29 } },
+};
+
+static const struct tb378fc_panel_cmd tb378fc_off[] = {
+	{ 0x05, 1, 16, { 0x28 } },
+	{ 0x05, 1, 120, { 0x10 } },
+};
+
+static int tb378fc_send_commands(struct novatek_nt36526 *ctx,
+		const struct tb378fc_panel_cmd *commands, size_t count, u16 flags)
+{
+	/* The pinned SM8750 dual-DSI host broadcasts commands from DSI1. */
+	struct mipi_dsi_device *dsi = ctx->dsi[1];
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	unsigned int i;
+	ssize_t ret;
+
+	if (!ops || !ops->transfer)
+		return -ENOSYS;
+	for (i = 0; i < count; i++) {
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = commands[i].type,
+			.tx_buf = commands[i].data,
+			.tx_len = commands[i].len,
+			.flags = flags,
+		};
+
+		ret = ops->transfer(dsi->host, &msg);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "command %u type %#x failed: %zd\n",
+				i, commands[i].type, ret);
+			return ret;
+		}
+		if (commands[i].wait_ms)
+			msleep(commands[i].wait_ms);
+	}
+	return 0;
+}
+
+static int novatek_nt36526_on(struct novatek_nt36526 *ctx)
+{
+	return tb378fc_send_commands(ctx, tb378fc_on, ARRAY_SIZE(tb378fc_on),
+				     MIPI_DSI_MSG_USE_LPM);
+}
+
+static int novatek_nt36526_off(struct novatek_nt36526 *ctx)
+{
+	/* Native off-command-state is HS, unlike the LP on sequence. */
+	return tb378fc_send_commands(ctx, tb378fc_off, ARRAY_SIZE(tb378fc_off), 0);
+}
+
+/* vddio delay from native panel supply entries; bias sequencing is handled
+ * by the paired board regulator, using the vendor's ENP/ENN order.
+ */
+static int novatek_nt36526_power_on(struct novatek_nt36526 *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	msleep(20);
+	ret = regulator_enable(ctx->bias);
+	if (ret) {
+		regulator_disable(ctx->vddio);
+		return ret;
+	}
+	msleep(10);
+	return 0;
+}
+
+static void novatek_nt36526_power_off(struct novatek_nt36526 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->bias);
+	msleep(5);
+	regulator_disable(ctx->vddio);
+}
+
+static int novatek_nt36526_prepare(struct drm_panel *panel)
+{
+	struct novatek_nt36526 *ctx = to_novatek_nt36526(panel);
+	int ret;
+
+	ret = novatek_nt36526_power_on(ctx);
+	if (ret < 0)
+		return ret;
+
+	novatek_nt36526_reset(ctx);
+
+	/* The native 0x90/0x91/0x92 commands configure the panel DSC decoder.
+	 * Retain those per-link settings; do not send an extra full-width PPS.
+	 */
+	ret = novatek_nt36526_on(ctx);
+	if (ret < 0)
+		goto err;
+
+	dev_info(&ctx->dsi[0]->dev, "TB378FC_PANEL_PREPARED 42 commands complete\n");
+	return 0;
+
+err:
+	novatek_nt36526_power_off(ctx);
+
+	return ret;
+}
+
+static int novatek_nt36526_unprepare(struct drm_panel *panel)
+{
+	struct novatek_nt36526 *ctx = to_novatek_nt36526(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	int ret;
+
+	ret = novatek_nt36526_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "failed to off panel: %d\n", ret);
+
+	novatek_nt36526_power_off(ctx);
+
+	return 0;
+}
+
+static const struct drm_display_mode novatek_nt36526_mode = {
+	.clock = (1752 + 77 + 16 + 64) * 2 * (2190 + 26 + 4 + 220) * 120 / 1000,
+	.hdisplay = 3504,
+	.hsync_start = (1752 + 77) * 2,
+	.hsync_end = (1752 + 77 + 16) * 2,
+	.htotal = (1752 + 77 + 16 + 64) * 2,
+	.vdisplay = 2190,
+	.vsync_start = 2190 + 26,
+	.vsync_end = 2190 + 26 + 4,
+	.vtotal = 2190 + 26 + 4 + 220,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int novatek_nt36526_get_modes(struct drm_panel *panel,
+				     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	connector->display_info.width_mm = 280;
+	connector->display_info.height_mm = 175;
+	connector->display_info.bpc = 10;
+	mode = drm_mode_duplicate(connector->dev, &novatek_nt36526_mode);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs novatek_nt36526_panel_funcs = {
+	.prepare = novatek_nt36526_prepare,
+	.unprepare = novatek_nt36526_unprepare,
+	.get_modes = novatek_nt36526_get_modes,
+};
+
+static int novatek_nt36526_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_device_info dsi_info = { "dsi-secondary", 0, NULL };
+	struct mipi_dsi_host *dsi1_host;
+	struct device *dev = &dsi->dev;
+	struct device_node *dsi1;
+	struct novatek_nt36526 *ctx;
+	int ret, i;
+
+	ctx = devm_drm_panel_alloc(dev, struct novatek_nt36526, panel,
+				   &novatek_nt36526_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio),
+				     "failed to get vddio regulator\n");
+
+	ctx->bias = devm_regulator_get(dev, "bias");
+	if (IS_ERR(ctx->bias))
+		return dev_err_probe(dev, PTR_ERR(ctx->bias),
+				     "failed to get paired bias supply\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	/* port@1 of the panel node points at the secondary DSI host */
+	dsi1 = of_graph_get_remote_node(dsi->dev.of_node, 1, -1);
+	if (!dsi1)
+		return dev_err_probe(dev, -ENODEV,
+				     "cannot get secondary DSI node\n");
+
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "cannot get secondary DSI host\n");
+
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host,
+							 &dsi_info);
+	if (IS_ERR(ctx->dsi[1]))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]),
+				     "cannot get secondary DSI device\n");
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	mipi_dsi_set_drvdata(ctx->dsi[1], ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 2;
+	ctx->dsc.slice_height = 30;
+	ctx->dsc.slice_width = 876;
+	ctx->dsc.slice_count = 1752 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	for (i = 0; i < 2; i++) {
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB101010;
+		/* Vendor stock keeps the DSI clock lane in continuous HS (no
+		 * NON_CONTINUOUS property in the panel dtsi); this DSC video
+		 * panel loses receiver lock if the clock lane drops to LP
+		 * during blanking, so match the vendor and run continuous. */
+		ctx->dsi[i]->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+					  MIPI_DSI_MODE_LPM;
+		ctx->dsi[i]->dsc = &ctx->dsc;
+		/* vendor packs two 876-px slices into each video packet */
+		ctx->dsi[i]->dsc_slice_per_pkt = 2;
+
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0) {
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret,
+					     "failed to attach to DSI host\n");
+		}
+	}
+
+	return 0;
+}
+
+static void novatek_nt36526_remove(struct mipi_dsi_device *dsi)
+{
+	struct novatek_nt36526 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id novatek_nt36526_of_match[] = {
+	{ .compatible = "lenovo,tb378fc-nt36526" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, novatek_nt36526_of_match);
+
+static struct mipi_dsi_driver novatek_nt36526_driver = {
+	.probe = novatek_nt36526_probe,
+	.remove = novatek_nt36526_remove,
+	.driver = {
+		.name = "panel-novatek-nt36526",
+		.of_match_table = novatek_nt36526_of_match,
+	},
+};
+module_mipi_dsi_driver(novatek_nt36526_driver);
+
+MODULE_AUTHOR("Erwin <yzddmr7@gmail.com>");
+MODULE_DESCRIPTION("Novatek NT36526 dual-DSI video mode panel driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/regulator/tb378fc-panel-bias.c b/drivers/regulator/tb378fc-panel-bias.c
new file mode 100644
index 000000000..2a00a3cf1
--- /dev/null
+++ b/drivers/regulator/tb378fc-panel-bias.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* TB378FC LCD bias: board-specific because the vendor names the IC only "bias".
+ * Register values and GPIO order come from this unit's msm_drm.ko bias_enable().
+ * Do not identify it as TPS65132: the vendor writes control register 0x02.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+struct tb378fc_bias {
+	struct regmap *regmap;
+	struct gpio_desc *positive;
+	struct gpio_desc *negative;
+};
+
+static const struct reg_sequence tb378fc_bias_init[] = {
+	{ 0x00, 0x13 }, { 0x01, 0x13 }, { 0x02, 0x33 },
+};
+
+static int tb378fc_bias_enable(struct regulator_dev *rdev)
+{
+	struct tb378fc_bias *bias = rdev_get_drvdata(rdev);
+	int ret;
+
+	ret = regmap_multi_reg_write(bias->regmap, tb378fc_bias_init,
+				     ARRAY_SIZE(tb378fc_bias_init));
+	if (ret)
+		return ret;
+	ret = gpiod_direction_output(bias->positive, 1);
+	if (ret)
+		return ret;
+	/* The vendor repeats the configuration after asserting ENP. */
+	ret = regmap_multi_reg_write(bias->regmap, tb378fc_bias_init,
+				     ARRAY_SIZE(tb378fc_bias_init));
+	if (ret)
+		goto fail;
+	msleep(5);
+	ret = gpiod_direction_output(bias->negative, 1);
+	if (!ret)
+		return 0;
+fail:
+	gpiod_direction_output(bias->negative, 0);
+	gpiod_direction_output(bias->positive, 0);
+	return ret;
+}
+
+static int tb378fc_bias_disable(struct regulator_dev *rdev)
+{
+	struct tb378fc_bias *bias = rdev_get_drvdata(rdev);
+	int ret;
+
+	ret = gpiod_direction_output(bias->negative, 0);
+	if (ret)
+		return ret;
+	msleep(5);
+	return gpiod_direction_output(bias->positive, 0);
+}
+
+static int tb378fc_bias_is_enabled(struct regulator_dev *rdev)
+{
+	struct tb378fc_bias *bias = rdev_get_drvdata(rdev);
+	int pos = gpiod_get_value_cansleep(bias->positive);
+	int neg = gpiod_get_value_cansleep(bias->negative);
+
+	if (pos < 0)
+		return pos;
+	if (neg < 0)
+		return neg;
+	return pos && neg;
+}
+
+static const struct regulator_ops tb378fc_bias_ops = {
+	.enable = tb378fc_bias_enable,
+	.disable = tb378fc_bias_disable,
+	.is_enabled = tb378fc_bias_is_enabled,
+};
+
+static const struct regulator_desc tb378fc_bias_desc = {
+	.name = "tb378fc-panel-bias",
+	.owner = THIS_MODULE,
+	.type = REGULATOR_VOLTAGE,
+	.ops = &tb378fc_bias_ops,
+	/* One logical supply controls the positive and negative rails together.
+	 * No voltage programming API: keep the vendor's exact register values.
+	 */
+};
+
+static const struct regmap_config tb378fc_bias_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x02,
+};
+
+static int tb378fc_bias_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = {};
+	struct regulator_dev *rdev;
+	struct tb378fc_bias *bias;
+
+	bias = devm_kzalloc(dev, sizeof(*bias), GFP_KERNEL);
+	if (!bias)
+		return -ENOMEM;
+	bias->regmap = devm_regmap_init_i2c(client, &tb378fc_bias_regmap);
+	if (IS_ERR(bias->regmap))
+		return dev_err_probe(dev, PTR_ERR(bias->regmap), "regmap init failed\n");
+	/* Leave inherited rails untouched until the panel requests a transition. */
+	bias->positive = devm_gpiod_get(dev, "positive", GPIOD_ASIS);
+	if (IS_ERR(bias->positive))
+		return dev_err_probe(dev, PTR_ERR(bias->positive), "missing ENP\n");
+	bias->negative = devm_gpiod_get(dev, "negative", GPIOD_ASIS);
+	if (IS_ERR(bias->negative))
+		return dev_err_probe(dev, PTR_ERR(bias->negative), "missing ENN\n");
+	config.dev = dev;
+	config.of_node = dev->of_node;
+	config.driver_data = bias;
+	config.init_data = of_get_regulator_init_data(dev, dev->of_node,
+						    &tb378fc_bias_desc);
+	if (!config.init_data)
+		return -EINVAL;
+	rdev = devm_regulator_register(dev, &tb378fc_bias_desc, &config);
+	return PTR_ERR_OR_ZERO(rdev);
+}
+
+static const struct of_device_id tb378fc_bias_match[] = {
+	{ .compatible = "lenovo,tb378fc-panel-bias" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tb378fc_bias_match);
+
+static struct i2c_driver tb378fc_bias_driver = {
+	.probe = tb378fc_bias_probe,
+	.driver = {
+		.name = "tb378fc-panel-bias",
+		.of_match_table = tb378fc_bias_match,
+	},
+};
+module_i2c_driver(tb378fc_bias_driver);
+MODULE_DESCRIPTION("Lenovo TB378FC paired LCD bias control");
+MODULE_LICENSE("GPL");
diff --git a/drivers/tty/serial/tb378fc-earlyram.c b/drivers/tty/serial/tb378fc-earlyram.c
new file mode 100644
index 000000000..9fbf89f5a
--- /dev/null
+++ b/drivers/tty/serial/tb378fc-earlyram.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Temporary early boot diagnostics for TB378FC. The first page of the
+ * reserved ramoops console uses the persistent_ram_buffer wire format,
+ * with ECC disabled, so Android can recover it after a warm reboot.
+ * CONFIG_PSTORE_RAM must be disabled in this diagnostic kernel: the normal
+ * ramoops driver would otherwise become a second writer to the same page.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/serial_core.h>
+#include <linux/sizes.h>
+
+#define TB378RAM_SIGNATURE 0x43474244
+#define TB378RAM_HEADER 12
+#define TB378RAM_CAPACITY (SZ_4K - TB378RAM_HEADER)
+
+static void __iomem *tb378ram_base;
+static u32 tb378ram_start;
+static u32 tb378ram_size;
+
+static void tb378ram_write(struct console *con, const char *text, unsigned int count)
+{
+	u32 chunk;
+
+	while (count) {
+		chunk = min_t(u32, count, TB378RAM_CAPACITY - tb378ram_start);
+		memcpy_toio(tb378ram_base + TB378RAM_HEADER + tb378ram_start,
+			    text, chunk);
+		tb378ram_start = (tb378ram_start + chunk) % TB378RAM_CAPACITY;
+		tb378ram_size = min_t(u32, TB378RAM_CAPACITY, tb378ram_size + chunk);
+		text += chunk;
+		count -= chunk;
+	}
+	wmb();
+	writel(tb378ram_start, tb378ram_base + 4);
+	writel(tb378ram_size, tb378ram_base + 8);
+}
+
+static int __init tb378ram_setup(struct earlycon_device *device, const char *options)
+{
+	if (IS_ENABLED(CONFIG_PSTORE_RAM))
+		return -EBUSY;
+	/* Target RAM console, or the reserved QEMU test address. */
+	if (device->port.mapbase != 0xc2000000 &&
+	    device->port.mapbase != 0x60000000)
+		return -EINVAL;
+	if (!device->port.membase)
+		return -ENODEV;
+	tb378ram_base = device->port.membase;
+	writel(TB378RAM_SIGNATURE, tb378ram_base);
+	writel(0, tb378ram_base + 4);
+	writel(0, tb378ram_base + 8);
+	device->con->write = tb378ram_write;
+	return 0;
+}
+EARLYCON_DECLARE(tb378ram, tb378ram_setup);
diff --git a/drivers/video/backlight/tb378fc-aw99706b.c b/drivers/video/backlight/tb378fc-aw99706b.c
new file mode 100644
index 000000000..ac1c9fa74
--- /dev/null
+++ b/drivers/video/backlight/tb378fc-aw99706b.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* TB378FC AW99706B: preserve the board's vendor register configuration.
+ * Source: aw99706b_init_table and _bl_set_brightness in this unit's msm_drm.ko.
+ * No MTP writes and no guessed current limits.
+ */
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+struct tb378fc_bl {
+	struct regmap *regmap;
+	struct regmap *secondary;
+	struct gpio_desc *enable;
+	struct mutex lock;
+	bool on;
+};
+
+static int tb378fc_bl_write(struct tb378fc_bl *ctx, unsigned int reg,
+			   unsigned int value)
+{
+	int ret = regmap_write(ctx->regmap, reg, value);
+
+	if (!ret)
+		ret = regmap_write(ctx->secondary, reg, value);
+	return ret;
+}
+
+static const struct reg_sequence tb378fc_bl_init[] = {
+	{ 0x0d, 0x00 }, { 0x0c, 0x48 }, { 0x06, 0xd9 }, { 0x07, 0x05 },
+	{ 0x04, 0x00 }, { 0x05, 0x00 }, { 0x08, 0x01 }, { 0x0d, 0xfe },
+};
+
+static int tb378fc_bl_update(struct backlight_device *bl)
+{
+	struct tb378fc_bl *ctx = bl_get_data(bl);
+	unsigned int brightness = backlight_get_brightness(bl);
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+	if (!brightness) {
+		if (ctx->on)
+			ret = tb378fc_bl_write(ctx, 0x0d, 0x00);
+		gpiod_direction_output(ctx->enable, 0);
+		ctx->on = false;
+		goto out;
+	}
+	if (!ctx->on) {
+		ret = gpiod_direction_output(ctx->enable, 1);
+		if (ret)
+			goto out;
+		usleep_range(5000, 6000);
+		ret = regmap_multi_reg_write(ctx->regmap, tb378fc_bl_init,
+					    ARRAY_SIZE(tb378fc_bl_init));
+		if (ret)
+			goto disable;
+		ret = regmap_multi_reg_write(ctx->secondary, tb378fc_bl_init,
+					    ARRAY_SIZE(tb378fc_bl_init));
+		if (ret)
+			goto disable;
+		ctx->on = true;
+	}
+	ret = tb378fc_bl_write(ctx, 0x04, (brightness >> 8) & 0x0f);
+	if (ret)
+		goto disable;
+	ret = tb378fc_bl_write(ctx, 0x05, brightness & 0xff);
+	if (!ret)
+		goto out;
+disable:
+	gpiod_direction_output(ctx->enable, 0);
+	ctx->on = false;
+out:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static const struct backlight_ops tb378fc_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = tb378fc_bl_update,
+};
+
+static const struct regmap_config tb378fc_bl_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	/* Registers 0x1e/0x1f control MTP. Keep them inaccessible. */
+	.max_register = 0x13,
+};
+
+static int tb378fc_bl_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = 4095,
+		.brightness = 906,
+		.power = BACKLIGHT_POWER_OFF,
+	};
+	struct backlight_device *bl;
+	struct tb378fc_bl *ctx;
+	struct device_node *secondary_bus;
+	struct i2c_adapter *adapter;
+	struct i2c_client *secondary;
+	unsigned int id;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	mutex_init(&ctx->lock);
+	ctx->regmap = devm_regmap_init_i2c(client, &tb378fc_bl_regmap);
+	if (IS_ERR(ctx->regmap))
+		return dev_err_probe(dev, PTR_ERR(ctx->regmap), "regmap init failed\n");
+	/* Native DT: primary 888000:76, secondary 880000:76; shared HWEN. */
+	secondary_bus = of_parse_phandle(dev->of_node, "lenovo,secondary-i2c-bus", 0);
+	if (!secondary_bus)
+		return dev_err_probe(dev, -EINVAL, "missing secondary backlight bus\n");
+	adapter = of_find_i2c_adapter_by_node(secondary_bus);
+	of_node_put(secondary_bus);
+	if (!adapter)
+		return dev_err_probe(dev, -EPROBE_DEFER, "secondary bus not ready\n");
+	secondary = devm_i2c_new_dummy_device(dev, adapter, 0x76);
+	i2c_put_adapter(adapter);
+	if (IS_ERR(secondary))
+		return dev_err_probe(dev, PTR_ERR(secondary), "secondary client failed\n");
+	ctx->secondary = devm_regmap_init_i2c(secondary, &tb378fc_bl_regmap);
+	if (IS_ERR(ctx->secondary))
+		return dev_err_probe(dev, PTR_ERR(ctx->secondary), "secondary regmap failed\n");
+	ctx->enable = devm_gpiod_get(dev, "enable", GPIOD_ASIS);
+	if (IS_ERR(ctx->enable))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable), "missing HWEN\n");
+	/* UEFI has already enabled HWEN. Reading ID does not alter its setup. */
+	ret = regmap_read(ctx->regmap, 0x11, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "chip ID read failed\n");
+	if (id != 0x07)
+		return dev_err_probe(dev, -ENODEV, "unexpected chip ID %02x\n", id);
+	ret = regmap_read(ctx->secondary, 0x11, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "secondary chip ID read failed\n");
+	if (id != 0x07)
+		return dev_err_probe(dev, -ENODEV, "unexpected secondary ID %02x\n", id);
+	dev_info(dev, "TB378FC_DUAL_BACKLIGHT both chip IDs verified\n");
+	bl = devm_backlight_device_register(dev, "tb378fc-backlight", dev,
+					   ctx, &tb378fc_bl_ops, &props);
+	return PTR_ERR_OR_ZERO(bl);
+}
+
+static const struct of_device_id tb378fc_bl_match[] = {
+	{ .compatible = "lenovo,tb378fc-aw99706b" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tb378fc_bl_match);
+
+static struct i2c_driver tb378fc_bl_driver = {
+	.probe = tb378fc_bl_probe,
+	.driver = {
+		.name = "tb378fc-aw99706b",
+		.of_match_table = tb378fc_bl_match,
+	},
+};
+module_i2c_driver(tb378fc_bl_driver);
+MODULE_DESCRIPTION("Lenovo TB378FC AW99706B backlight");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/codecs/aw88480.c b/sound/soc/codecs/aw88480.c
new file mode 100644
index 000000000..0af4971f7
--- /dev/null
+++ b/sound/soc/codecs/aw88480.c
@@ -0,0 +1,595 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* AW88480 / PID 0x2418 ASoC bring-up.
+ * Register definitions and sequencing: Awinic AW882XX Qcom v2.0.13,
+ * aw882xx_init.[ch] and aw882xx_device.c (GPL-2.0).
+ * Uses this board's original Music register bins through the upstream ACF parser.
+ */
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+#include "aw88395/aw88395_device.h"
+
+#define AW48_ID                 0x00
+#define AW48_STATUS             0x01
+#define AW48_INT                0x02
+#define AW48_INT_MASK           0x03
+#define AW48_CTRL               0x04
+#define AW48_VOLUME             0x05
+#define AW48_TX                 0x08
+#define AW48_VBAT               0x20
+#define AW48_TEMP               0x21
+#define AW48_DBG                0x25
+#define AW48_LPC                0x3a
+#define AW48_NOISE_GATE         0x52
+#define AW48_TRIM               0x76
+#define AW48_PWDN               BIT(0)
+#define AW48_AMPPD              BIT(1)
+#define AW48_MUTE               BIT(8)
+#define AW48_ULS_MUTE           BIT(15)
+#define AW48_TXEN               BIT(5)
+#define AW48_DITHER             BIT(15)
+#define AW48_CCO_BYPASS         BIT(13)
+#define AW48_LPC_EN             BIT(8)
+#define AW48_ATTENUATION        GENMASK(9, 0)
+#define AW48_PLL_READY          (BIT(4) | BIT(0))
+#define AW48_NO_SWS_READY       (BIT(9) | AW48_PLL_READY)
+#define AW48_SWS_READY          (BIT(8) | AW48_NO_SWS_READY)
+#define AW48_TRIM_LOCKED        BIT(15)
+#define AW48_FAULTS             (BIT(14) | BIT(11) | BIT(5) | BIT(3) | BIT(1))
+/* Bring-up ceiling until vendor excursion/thermal protection is available. */
+#define AW48_GAIN_MAX           487 /* At least 6 dB below native Music. */
+#define AW48_GAIN_DEFAULT       463 /* Default to 12 dB attenuation. */
+
+struct aw88480 {
+	struct aw_device aw;
+	struct regmap *regmap;
+	struct gpio_desc *reset;
+	struct mutex lock;
+	struct delayed_work start_work;
+	struct delayed_work monitor_work;
+	u8 *registers;
+	unsigned int register_bytes;
+	unsigned int channel;
+	unsigned int gain;
+	unsigned int native_attenuation;
+	unsigned int attenuation;
+	u16 dither, lpc, tx;
+	bool requested, powered, running;
+	int last_error;
+};
+
+static const struct regmap_config aw88480_regmap = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+	/* The native Music bins also program zeroes at 0x80..0x89. */
+	.max_register = 0x89,
+};
+
+static int aw88480_ramp(struct aw88480 *amp, unsigned int target)
+{
+	int ret;
+
+	while (amp->attenuation != target) {
+		unsigned int next = amp->attenuation;
+
+		if (next < target)
+			next += min(64U, target - next);
+		else
+			next -= min(64U, next - target);
+		ret = regmap_update_bits(amp->regmap, AW48_VOLUME,
+					 AW48_ATTENUATION, next);
+		if (ret)
+			return ret;
+		amp->attenuation = next;
+		usleep_range(500, 600);
+	}
+	return 0;
+}
+
+static void aw88480_stop(struct aw88480 *amp)
+{
+	cancel_delayed_work(&amp->monitor_work);
+	if (amp->powered) {
+		aw88480_ramp(amp, AW48_ATTENUATION);
+		regmap_update_bits(amp->regmap, AW48_CTRL,
+				   AW48_MUTE | AW48_ULS_MUTE,
+				   AW48_MUTE | AW48_ULS_MUTE);
+		usleep_range(5000, 5100);
+		regmap_update_bits(amp->regmap, AW48_TX, AW48_TXEN, 0);
+		regmap_update_bits(amp->regmap, AW48_CTRL,
+				   AW48_AMPPD | AW48_PWDN,
+				   AW48_AMPPD | AW48_PWDN);
+	}
+	/* Reset also makes a failed or partial configuration unconditionally quiet. */
+	gpiod_set_value_cansleep(amp->reset, 1);
+	amp->powered = false;
+}
+
+static int aw88480_configure(struct aw88480 *amp)
+{
+	unsigned int i, trim, id;
+	int ret;
+
+	gpiod_set_value_cansleep(amp->reset, 0);
+	usleep_range(2000, 2100);
+	/* Early probe bus traffic disrupts display initialization on this board.
+	 * Validate the real chip before any configuration writes at PCM start.
+	 */
+	ret = regmap_read(amp->regmap, AW48_ID, &id);
+	if (ret)
+		return ret;
+	if (id != 0x2418)
+		return dev_err_probe(amp->aw.dev, -ENODEV, "unexpected chip ID %#x\n", id);
+	dev_info(amp->aw.dev, "AW88480 channel%u chip ID verified=0x%04x\n",
+		 amp->channel, id);
+	ret = regmap_write(amp->regmap, AW48_ID, 0x55aa);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1100);
+	ret = regmap_read(amp->regmap, AW48_TRIM, &trim);
+	if (ret)
+		return ret;
+	if (!(trim & AW48_TRIM_LOCKED))
+		return -EIO;
+
+	for (i = 0; i < amp->register_bytes; i += 4) {
+		unsigned int reg = get_unaligned_le16(amp->registers + i);
+		unsigned int value = get_unaligned_le16(amp->registers + i + 2);
+
+		if (reg == AW48_CTRL)
+			value |= AW48_PWDN | AW48_AMPPD | AW48_MUTE | AW48_ULS_MUTE;
+		if (reg == AW48_INT_MASK)
+			value = 0xffff;
+		if (reg == AW48_VOLUME) {
+			amp->native_attenuation = value & AW48_ATTENUATION;
+			value |= AW48_ATTENUATION;
+		}
+		if (reg == AW48_TX) {
+			amp->tx = value & AW48_TXEN;
+			value &= ~AW48_TXEN;
+		}
+		if (reg == AW48_DBG) {
+			amp->dither = value & AW48_DITHER;
+			value &= ~AW48_DITHER;
+		}
+		if (reg == AW48_LPC) {
+			amp->lpc = value & AW48_LPC_EN;
+			value &= ~AW48_LPC_EN;
+		}
+		ret = regmap_write(amp->regmap, reg, value);
+		if (ret)
+			return ret;
+	}
+	amp->attenuation = AW48_ATTENUATION;
+	return 0;
+}
+
+static int aw88480_start(struct aw88480 *amp)
+{
+	unsigned int status, gate, ready;
+	int ret;
+
+	ret = aw88480_configure(amp);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(amp->regmap, AW48_CTRL, AW48_PWDN, 0);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(amp->regmap, AW48_STATUS, status,
+			(status & AW48_PLL_READY) == AW48_PLL_READY, 2000, 40000);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(amp->regmap, AW48_CTRL, AW48_AMPPD, 0);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1100);
+	ret = regmap_read(amp->regmap, AW48_NOISE_GATE, &gate);
+	if (ret)
+		return ret;
+	ready = gate & BIT(0) ? AW48_NO_SWS_READY : AW48_SWS_READY;
+	ret = regmap_read_poll_timeout(amp->regmap, AW48_STATUS, status,
+			(status & ready) == ready && !(status & AW48_FAULTS), 2000, 40000);
+	if (ret)
+		return ret;
+	/* No capture graph yet: do not drive the shared feedback data line. */
+	ret = regmap_update_bits(amp->regmap, AW48_TX, AW48_TXEN, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(amp->regmap, AW48_CTRL,
+				 AW48_MUTE | AW48_ULS_MUTE, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(amp->regmap, AW48_DBG, AW48_DITHER, amp->dither);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(amp->regmap, AW48_LPC, AW48_LPC_EN, amp->lpc);
+	if (ret)
+		return ret;
+	ret = aw88480_ramp(amp, min(1023U, amp->native_attenuation +
+						2 * (511 - amp->gain)));
+	if (ret)
+		return ret;
+	amp->powered = true;
+	dev_info(amp->aw.dev, "AW88480 channel%u running status=0x%04x attenuation=%u\n",
+		 amp->channel, status, amp->attenuation);
+	return 0;
+}
+
+static void aw88480_monitor_work(struct work_struct *work)
+{
+	struct aw88480 *amp = container_of(to_delayed_work(work), struct aw88480, monitor_work);
+	unsigned int status;
+	int ret;
+
+	mutex_lock(&amp->lock);
+	if (!amp->powered || !amp->requested || !READ_ONCE(amp->running))
+		goto out;
+	ret = regmap_read(amp->regmap, AW48_STATUS, &status);
+	/* Native silence detection can report zero; fault bits are always fatal. */
+	if (ret || (status & AW48_FAULTS)) {
+		amp->last_error = ret ?: -EIO;
+		dev_err(amp->aw.dev, "AW88480 runtime fault status=0x%04x error=%d, resetting\n",
+			ret ? 0 : status, amp->last_error);
+		aw88480_stop(amp);
+	} else {
+		schedule_delayed_work(&amp->monitor_work, msecs_to_jiffies(100));
+	}
+out:
+	mutex_unlock(&amp->lock);
+}
+
+static void aw88480_start_work(struct work_struct *work)
+{
+	struct aw88480 *amp = container_of(to_delayed_work(work), struct aw88480, start_work);
+	int attempt, ret = -EIO;
+
+	mutex_lock(&amp->lock);
+	if (!amp->requested || !READ_ONCE(amp->running)) {
+		aw88480_stop(amp);
+		goto out;
+	}
+	if (amp->powered)
+		goto out;
+	for (attempt = 0; attempt < 3; attempt++) {
+		if (!READ_ONCE(amp->running)) {
+			ret = 0;
+			break;
+		}
+		ret = aw88480_start(amp);
+		if (!ret)
+			break;
+		aw88480_stop(amp);
+		usleep_range(5000, 5100);
+	}
+	amp->last_error = ret;
+	if (ret)
+		dev_err(amp->aw.dev, "AW88480 start failed, stays muted: %d\n", ret);
+	else if (amp->powered && READ_ONCE(amp->running))
+		schedule_delayed_work(&amp->monitor_work, msecs_to_jiffies(100));
+out:
+	mutex_unlock(&amp->lock);
+}
+
+static int aw88480_mute(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct aw88480 *amp = snd_soc_component_get_drvdata(dai->component);
+
+	if (stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+	if (mute) {
+		cancel_delayed_work_sync(&amp->start_work);
+		cancel_delayed_work_sync(&amp->monitor_work);
+	}
+	mutex_lock(&amp->lock);
+	amp->requested = !mute;
+	if (mute)
+		aw88480_stop(amp);
+	else if (READ_ONCE(amp->running))
+		schedule_delayed_work(&amp->start_work, msecs_to_jiffies(2));
+	mutex_unlock(&amp->lock);
+	return 0;
+}
+
+static int aw88480_trigger(struct snd_pcm_substream *substream, int cmd,
+			  struct snd_soc_dai *dai)
+{
+	struct aw88480 *amp = snd_soc_component_get_drvdata(dai->component);
+	bool running;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		running = true;
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		running = false;
+		break;
+	default:
+		return -EINVAL;
+	}
+	/* ALSA may trigger in atomic context: all I2C/reset work stays in workqueues. */
+	WRITE_ONCE(amp->running, running);
+	mod_delayed_work(system_dfl_wq, &amp->start_work,
+			 running ? msecs_to_jiffies(2) : 0);
+	return 0;
+}
+
+static int aw88480_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	/* The board firmware supplies the native DSP_B framing registers. */
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_DSP_B)
+		return -EINVAL;
+	if ((fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF &&
+	    (fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_IB_NF)
+		return -EINVAL;
+	return 0;
+}
+
+static int aw88480_set_slots(struct snd_soc_dai *dai, unsigned int tx,
+			    unsigned int rx, int slots, int width)
+{
+	struct aw88480 *amp = snd_soc_component_get_drvdata(dai->component);
+
+	if ((slots != 4 && slots != 8) || width != 32 || amp->channel >= slots)
+		return -EINVAL;
+	if (rx != BIT(amp->channel) || (tx && tx != BIT(amp->channel)))
+		return -EINVAL;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops aw88480_ops = {
+	.set_fmt = aw88480_set_fmt,
+	.set_tdm_slot = aw88480_set_slots,
+	.mute_stream = aw88480_mute,
+	.trigger = aw88480_trigger,
+	.no_capture_mute = 1,
+};
+
+static struct snd_soc_dai_driver aw88480_dai = {
+	.name = "aw88480-aif",
+	.playback = {
+		.stream_name = "Speaker Playback",
+		.channels_min = 1,
+		.channels_max = 8,
+		.rates = SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &aw88480_ops,
+};
+
+static int aw88480_volume_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw88480 *amp = snd_soc_component_get_drvdata(component);
+
+	mutex_lock(&amp->lock);
+	value->value.integer.value[0] = amp->gain;
+	mutex_unlock(&amp->lock);
+	return 0;
+}
+
+static int aw88480_volume_put(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw88480 *amp = snd_soc_component_get_drvdata(component);
+	unsigned int gain = value->value.integer.value[0];
+	int ret = 1;
+
+	if (gain > AW48_GAIN_MAX)
+		return -EINVAL;
+	mutex_lock(&amp->lock);
+	if (gain == amp->gain) {
+		ret = 0;
+		goto out;
+	}
+	if (amp->powered) {
+		ret = aw88480_ramp(amp, min(1023U, amp->native_attenuation + 2 * (511 - gain)));
+		if (ret)
+			goto out;
+		ret = 1;
+	}
+	amp->gain = gain;
+out:
+	mutex_unlock(&amp->lock);
+	return ret;
+}
+
+static const DECLARE_TLV_DB_SCALE(aw88480_volume_tlv, -12775, 25, 0);
+static const struct snd_kcontrol_new aw88480_controls[] = {
+	SOC_SINGLE_EXT_TLV("Playback Volume", SND_SOC_NOPM, 0, AW48_GAIN_MAX, 0,
+			   aw88480_volume_get, aw88480_volume_put, aw88480_volume_tlv),
+};
+static const struct snd_soc_dapm_widget aw88480_widgets[] = {
+	SND_SOC_DAPM_AIF_IN("AIF_RX", "Speaker Playback", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_OUTPUT("OUT"),
+};
+static const struct snd_soc_dapm_route aw88480_routes[] = {
+	{ "OUT", NULL, "AIF_RX" },
+};
+static const struct snd_soc_component_driver aw88480_component = {
+	.controls = aw88480_controls,
+	.num_controls = ARRAY_SIZE(aw88480_controls),
+	.dapm_widgets = aw88480_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(aw88480_widgets),
+	.dapm_routes = aw88480_routes,
+	.num_dapm_routes = ARRAY_SIZE(aw88480_routes),
+};
+
+static int aw88480_load_firmware(struct aw88480 *amp)
+{
+	const struct firmware *fw;
+	const char *name;
+	struct aw_container *cfg;
+	struct aw_sec_data_desc *regs;
+	unsigned int i;
+	int ret;
+
+	ret = device_property_read_string(amp->aw.dev, "firmware-name", &name);
+	if (ret)
+		return ret;
+	ret = request_firmware(&fw, name, amp->aw.dev);
+	if (ret)
+		return ret;
+	cfg = devm_kzalloc(amp->aw.dev, struct_size(cfg, data, fw->size), GFP_KERNEL);
+	if (!cfg) {
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+	cfg->len = fw->size;
+	memcpy(cfg->data, fw->data, fw->size);
+	release_firmware(fw);
+	ret = aw88395_dev_load_acf_check(&amp->aw, cfg);
+	if (ret)
+		return ret;
+	ret = aw88395_dev_cfg_load(&amp->aw, cfg);
+	if (ret)
+		return ret;
+	if (amp->aw.prof_info.count != 1)
+		return -EINVAL;
+	regs = &amp->aw.prof_info.prof_desc[0].sec_desc[AW88395_DATA_TYPE_REG];
+	if (!regs->len || regs->len % 4)
+		return -EINVAL;
+	/* This bring-up driver never accepts a reset/trim-programming entry. */
+	for (i = 0; i < regs->len; i += 4) {
+		unsigned int reg = get_unaligned_le16(regs->data + i);
+
+		if (reg < 3 || reg > 0x89 || (reg >= 0x76 && reg <= 0x7f))
+			return -EINVAL;
+	}
+	amp->registers = regs->data;
+	amp->register_bytes = regs->len;
+	return 0;
+}
+
+static ssize_t runtime_status_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct aw88480 *amp = dev_get_drvdata(dev);
+	unsigned int status = 0, volume = 0, vbat = 0, temp = 0;
+	int ret = 0, len;
+
+	mutex_lock(&amp->lock);
+	if (amp->powered) {
+		ret = regmap_read(amp->regmap, AW48_STATUS, &status);
+		if (!ret)
+			ret = regmap_read(amp->regmap, AW48_VOLUME, &volume);
+		if (!ret)
+			ret = regmap_read(amp->regmap, AW48_VBAT, &vbat);
+		if (!ret)
+			ret = regmap_read(amp->regmap, AW48_TEMP, &temp);
+	}
+	len = sysfs_emit(buf, "channel=%u powered=%u error=%d status=0x%04x read=%d gain=%u native=%u attenuation=%u volume=0x%04x vbat_raw=%u temp_raw=%u\n",
+			 amp->channel, amp->powered, amp->last_error, status, ret,
+			 amp->gain, amp->native_attenuation, amp->attenuation, volume,
+			 vbat, temp);
+	mutex_unlock(&amp->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(runtime_status);
+static struct attribute *aw88480_attrs[] = {
+	&dev_attr_runtime_status.attr, NULL
+};
+ATTRIBUTE_GROUPS(aw88480);
+
+static void aw88480_cleanup(void *data)
+{
+	struct aw88480 *amp = data;
+
+	cancel_delayed_work_sync(&amp->start_work);
+	cancel_delayed_work_sync(&amp->monitor_work);
+	mutex_lock(&amp->lock);
+	amp->requested = false;
+	aw88480_stop(amp);
+	mutex_unlock(&amp->lock);
+}
+
+static void aw88480_assert_reset(void *data)
+{
+	gpiod_set_value_cansleep(data, 1);
+}
+
+static void aw88480_shutdown(struct i2c_client *i2c)
+{
+	aw88480_cleanup(i2c_get_clientdata(i2c));
+}
+
+static int aw88480_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct aw88480 *amp;
+	int ret;
+
+	amp = devm_kzalloc(dev, sizeof(*amp), GFP_KERNEL);
+	if (!amp)
+		return -ENOMEM;
+	mutex_init(&amp->lock);
+	INIT_DELAYED_WORK(&amp->start_work, aw88480_start_work);
+	INIT_DELAYED_WORK(&amp->monitor_work, aw88480_monitor_work);
+	i2c_set_clientdata(i2c, amp);
+	amp->aw.dev = dev;
+	amp->aw.i2c = i2c;
+	amp->aw.chip_id = 0x2418;
+	amp->aw.prof_info.prof_type = AW88395_DEV_NONE_TYPE_ID;
+	amp->gain = AW48_GAIN_DEFAULT;
+	ret = device_property_read_u32(dev, "awinic,audio-channel", &amp->channel);
+	if (ret || amp->channel > 3)
+		return -EINVAL;
+	amp->aw.channel = amp->channel;
+	amp->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(amp->reset))
+		return dev_err_probe(dev, PTR_ERR(amp->reset), "reset GPIO\n");
+	ret = devm_add_action_or_reset(dev, aw88480_assert_reset, amp->reset);
+	if (ret)
+		return ret;
+	amp->regmap = devm_regmap_init_i2c(i2c, &aw88480_regmap);
+	if (IS_ERR(amp->regmap))
+		return PTR_ERR(amp->regmap);
+	amp->aw.regmap = amp->regmap;
+	ret = aw88480_load_firmware(amp);
+	if (ret)
+		return dev_err_probe(dev, ret, "native ACF\n");
+	gpiod_set_value_cansleep(amp->reset, 1);
+	/* This action must run before devres releases the regmap and ACF memory. */
+	ret = devm_add_action_or_reset(dev, aw88480_cleanup, amp);
+	if (ret)
+		return ret;
+	dev_info(dev, "AW88480 channel=%u native register pairs=%u, reset; ID checked at PCM start\n",
+		 amp->channel, amp->register_bytes / 4);
+	return devm_snd_soc_register_component(dev, &aw88480_component, &aw88480_dai, 1);
+}
+
+static const struct of_device_id aw88480_of_match[] = {
+	{ .compatible = "awinic,aw88480" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw88480_of_match);
+static struct i2c_driver aw88480_driver = {
+	.driver = {
+		.name = "aw88480",
+		.of_match_table = aw88480_of_match,
+		.dev_groups = aw88480_groups,
+	},
+	.probe = aw88480_probe,
+	.shutdown = aw88480_shutdown,
+};
+module_i2c_driver(aw88480_driver);
+MODULE_DESCRIPTION("Awinic AW88480 native-profile ASoC amplifier");
+MODULE_LICENSE("GPL");
