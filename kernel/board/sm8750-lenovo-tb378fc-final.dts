	sound {
		compatible = "qcom,sm8750-sndcard\0qcom,sm8450-sndcard";
		model = "Lenovo-TB378FC";
		widgets = "Speaker\0Speakers";
		audio-routing = "Speakers\0Amp0 OUT\0Speakers\0Amp1 OUT\0Speakers\0Amp2 OUT\0Speakers\0Amp3 OUT\0AMIC1\0MIC BIAS1\0AMIC4\0MIC BIAS3\0TX SWR_INPUT4\0ADC1_OUTPUT\0TX SWR_INPUT8\0ADC3_OUTPUT";
		pinctrl-names = "default";
		pinctrl-0 = <0x14a>;

		wcd-capture-dai-link {
			convert-sample-format = "s16_le";
			convert-channels = <0x02>;
			convert-rate = <0xbb80>;
			link-name = "WCD Capture";

			platform {
				sound-dai = <0x150>;
			};

			codec {
				sound-dai = <0x15d 0x01 0x15e 0x00 0x87 0x00>;
			};

			cpu {
				sound-dai = <0x14b 0x78>;
			};
		};

		speaker-playback-dai-link {
			link-name = "Speaker Playback";
			dai-format = "dsp_b";
			convert-rate = <0xbb80>;
			convert-channels = <0x04>;
			convert-sample-format = "s32_le";

			cpu {
				sound-dai = <0x14b 0x28>;
				dai-tdm-slot-num = <0x04>;
				dai-tdm-slot-width = <0x20>;
				dai-tdm-slot-rx-mask = <0x01 0x01 0x01 0x01>;
			};

			codec-0 {
				sound-dai = <0x14c>;
				dai-tdm-slot-tx-mask = <0x01>;
				dai-tdm-slot-rx-mask = <0x01>;
				bitclock-inversion;
			};

			codec-1 {
				sound-dai = <0x14d>;
				dai-tdm-slot-tx-mask = <0x00 0x01>;
				dai-tdm-slot-rx-mask = <0x00 0x01>;
				bitclock-inversion;
			};

			codec-2 {
				sound-dai = <0x14e>;
				dai-tdm-slot-tx-mask = <0x00 0x00 0x01>;
				dai-tdm-slot-rx-mask = <0x00 0x00 0x01>;
				bitclock-inversion;
			};

			codec-3 {
				sound-dai = <0x14f>;
				dai-tdm-slot-tx-mask = <0x00 0x00 0x00 0x01>;
				dai-tdm-slot-rx-mask = <0x00 0x00 0x00 0x01>;
				bitclock-inversion;
			};

			platform {
				sound-dai = <0x150>;
			};
		};
	};
};
