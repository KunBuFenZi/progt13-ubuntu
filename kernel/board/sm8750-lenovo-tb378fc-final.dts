		pinctrl-names = "default";
		pinctrl-0 = <0x147>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xba 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		#size-cells = <0x00>;
		#address-cells = <0x01>;
		compatible = "lenovo,tb378fc-pmic-glink\0qcom,sm8750-pmic-glink\0qcom,sm8550-pmic-glink\0qcom,pmic-glink";

		connector@0 {
			data-role = "dual";
			power-role = "dual";
			reg = <0x00>;
			compatible = "usb-c-connector";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@2 {
					reg = <0x02>;

					endpoint {
						phandle = <0x157>;
						remote-endpoint = <0x156>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						phandle = <0x155>;
						remote-endpoint = <0x154>;
					};
				};

				port@0 {
					reg = <0x00>;

					endpoint {
						phandle = <0x153>;
						remote-endpoint = <0x152>;
					};
				};
			};
		};
	};

