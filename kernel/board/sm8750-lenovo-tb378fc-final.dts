/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Lenovo Xiaoxin Pad Pro GT 13 (TB378FC, RAM diagnostics)";
	compatible = "lenovo,tb378fc\0qcom,sm8750";
	chassis-type = "tablet";

	tb378fc-wcd939x {
		phandle = <0x15d>;
		qcom,tx-device = <0x15c>;
		qcom,rx-device = <0x15b>;
		qcom,micbias4-microvolt = <0x1b7740>;
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,micbias2-microvolt = <0x1b7740>;
		qcom,micbias1-microvolt = <0x1b7740>;
		vdd-mic-bias-supply = <0x11e>;
		vdd-px-supply = <0xbd>;
		vdd-buck-supply = <0xbd>;
		vdd-io-supply = <0xbd>;
		vdd-rxtx-supply = <0xbd>;
		reset-gpios = <0x37 0x65 0x01>;
		pinctrl-0 = <0x15a>;
		pinctrl-names = "default";
		#sound-dai-cells = <0x01>;
		compatible = "qcom,wcd9390-codec";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x03 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x0d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x02>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x05 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x0e>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x06 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x0f>;
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x07 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x400>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x08 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x11>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x500>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x09 0x04 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x12>;
		};

		cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			next-level-cache = <0x0a>;
			power-domains = <0x0b 0x04 0x01>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x13>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x0a>;
			};
		};

		cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			next-level-cache = <0x0a>;
			power-domains = <0x0c 0x04 0x01>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x14>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};

				core4 {
					cpu = <0x11>;
				};

				core5 {
					cpu = <0x12>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x13>;
				};

				core1 {
					cpu = <0x14>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0x5d>;
				exit-latency-us = <0x81>;
				min-residency-us = <0x230>;
				phandle = <0x1c>;
			};

			cpu-sleep-1 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0xac>;
				exit-latency-us = <0x82>;
				min-residency-us = <0x2ae>;
				phandle = <0x1e>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				entry-latency-us = <0x866>;
				exit-latency-us = <0x7bf>;
				min-residency-us = <0x23b8>;
				phandle = <0x1f>;
			};

			domain-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x200c354>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x21>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8750\0qcom,scm";
			interconnects = <0x15 0x02 0x07 0x16 0x01 0x07>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x17 0x00 0x17 0x02>;
			mbox-names = "tx\0rx";
			shmem = <0x18 0x19>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x04>;
			};
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8750-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1a>;
		phandle = <0x2b>;
	};

	interconnect-1 {
		compatible = "qcom,sm8750-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1a>;
		phandle = <0x16>;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0xa0000000 0x00 0x00>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x03>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x05>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x06>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x07>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x08>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x09>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0b>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0c>;
		};

		power-domain-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1f>;
			power-domains = <0x20>;
			phandle = <0x1b>;
		};

		power-domain-cluster1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1f>;
			power-domains = <0x20>;
			phandle = <0x1d>;
		};

		power-domain-system {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x21>;
			phandle = <0x20>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		gunyah-hyp@80000000 {
			reg = <0x00 0x80000000 0x00 0x1200000>;
			no-map;
		};

		cpucp@81200000 {
			reg = <0x00 0x81200000 0x00 0x200000>;
			no-map;
		};

		xbl-dtlog@81a00000 {
			reg = <0x00 0x81a00000 0x00 0x40000>;
			no-map;
		};

		aop-image@81c00000 {
			reg = <0x00 0x81c00000 0x00 0x60000>;
			no-map;
		};

		aop-cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
		};

		aop-tme-uefi-merged@81c80000 {
			reg = <0x00 0x81c80000 0x00 0x74000>;
			no-map;
		};

		smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x81d00000 0x00 0x200000>;
			hwlocks = <0x22 0x03>;
			no-map;
		};

		pdp-ns-shared@81f00000 {
			reg = <0x00 0x81f00000 0x00 0x100000>;
			no-map;
		};

		cpucp-scandump@82000000 {
			reg = <0x00 0x82000000 0x00 0x380000>;
			no-map;
		};

		adsp-mhi@82380000 {
			reg = <0x00 0x82380000 0x00 0x20000>;
			no-map;
		};

		soccp-sdi@823a0000 {
			reg = <0x00 0x823a0000 0x00 0x40000>;
			no-map;
		};

		pmic-minii-dump@823e0000 {
			reg = <0x00 0x823e0000 0x00 0x80000>;
			no-map;
		};

		pvmfw@824a0000 {
			reg = <0x00 0x824a0000 0x00 0x100000>;
			no-map;
		};

		global-sync@82600000 {
			reg = <0x00 0x82600000 0x00 0x100000>;
			no-map;
			phandle = <0x127>;
		};

		tz-stat@82700000 {
			reg = <0x00 0x82700000 0x00 0x100000>;
			no-map;
		};

		qdss@82800000 {
			reg = <0x00 0x82800000 0x00 0x2000000>;
			no-map;
		};

		dsm-partition-1@84a00000 {
			reg = <0x00 0x84a00000 0x00 0x4900000>;
			no-map;
			phandle = <0x74>;
		};

		dsm-partition-2@89300000 {
			reg = <0x00 0x89300000 0x00 0xa80000>;
			no-map;
			phandle = <0x75>;
		};

		mpss@8ba00000 {
			reg = <0x00 0x8ba00000 0x00 0xf600000>;
			no-map;
			phandle = <0x72>;
		};

		q6-mpss-dtb@9b000000 {
			reg = <0x00 0x9b000000 0x00 0x80000>;
			no-map;
			phandle = <0x73>;
		};

		ipa-fw@9b080000 {
			reg = <0x00 0x9b080000 0x00 0x10000>;
			no-map;
		};

		ipa-gsi@9b090000 {
			reg = <0x00 0x9b090000 0x00 0xa000>;
			no-map;
		};

		gpu-micro-code@9b09a000 {
			reg = <0x00 0x9b09a000 0x00 0x2000>;
			no-map;
			phandle = <0xb6>;
		};

		spss@9b0a0000 {
			reg = <0x00 0x9b0a0000 0x00 0x1e0000>;
			no-map;
		};

		spu-tz-shared@9b280000 {
			reg = <0x00 0x9b280000 0x00 0x40000>;
			no-map;
		};

		spu-modem-shared@9b2c0000 {
			reg = <0x00 0x9b2c0000 0x00 0x40000>;
			no-map;
		};

		camera@9b300000 {
			reg = <0x00 0x9b300000 0x00 0x800000>;
			no-map;
		};

		camera-2@9bb00000 {
			reg = <0x00 0x9bb00000 0x00 0x800000>;
			no-map;
		};

		video@9c300000 {
			reg = <0x00 0x9c300000 0x00 0x800000>;
			no-map;
			phandle = <0x95>;
		};

		cvp@9cb00000 {
			reg = <0x00 0x9cb00000 0x00 0x700000>;
			no-map;
		};

		cdsp@9d200000 {
			reg = <0x00 0x9d200000 0x00 0x1900000>;
			no-map;
			phandle = <0x125>;
		};

		q6-cdsp-dtb@9eb00000 {
			reg = <0x00 0x9eb00000 0x00 0x80000>;
			no-map;
			phandle = <0x126>;
		};

		soccp@9ec00000 {
			reg = <0x00 0x9ec00000 0x00 0x180000>;
			no-map;
		};

		q6-adsp-dtb@9ed80000 {
			reg = <0x00 0x9ed80000 0x00 0x80000>;
			no-map;
			phandle = <0x7c>;
		};

		adspslpi@9ee00000 {
			reg = <0x00 0x9ee00000 0x00 0x3a80000>;
			no-map;
			phandle = <0x7b>;
		};

		xbl-ramdump@b8000000 {
			reg = <0x00 0xb8000000 0x00 0x1c0000>;
			no-map;
		};

		hwfence-shbuf@d4e23000 {
			no-map;
			reg = <0x00 0xd4e23000 0x00 0x2dd000>;
		};

		tz-merged@d8000000 {
			reg = <0x00 0xd8000000 0x00 0x600000>;
			no-map;
		};

		trust-ui-vm@f3800000 {
			reg = <0x00 0xf3800000 0x00 0x4400000>;
			no-map;
		};

		oem-vm@f7c00000 {
			reg = <0x00 0xf7c00000 0x00 0x4c00000>;
			no-map;
		};

		llcc-lpi@ff800000 {
			reg = <0x00 0xff800000 0x00 0x800000>;
			no-map;
		};

		adsp-rpc-remote-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			reusable;
			phandle = <0x7e>;
		};

		splash_region {
			label = "cont_splash_region";
			reg = <0x00 0xfc800000 0x00 0x2b00000>;
			no-map;
			iommu-addresses = <0x23 0x00 0xfc800000 0x00 0x2b00000>;
			phandle = <0x9c>;
		};

		ramoops@c2000000 {
			compatible = "ramoops";
			reg = <0x00 0xc2000000 0x00 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
			record-size = <0x00>;
			no-map;
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x24 0x03 0x02 0x01>;
		mboxes = <0x24 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x7d>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x79>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x24 0x06 0x02 0x01>;
		mboxes = <0x24 0x06 0x02>;
		qcom,smem = <0x5e 0x1b0>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x128>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x123>;
		};
	};

	smp2p-modem {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x24 0x02 0x02 0x01>;
		mboxes = <0x24 0x02 0x02>;
		qcom,smem = <0x1b3 0x1ac>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x77>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x71>;
		};

		ipa-ap-to-modem {
			qcom,entry-name = "ipa";
			#qcom,smem-state-cells = <0x01>;
		};

		ipa-modem-to-ap {
			qcom,entry-name = "ipa";
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;

		isp@ad27000 {
			phandle = <0x177>;
			status = "okay";
			dma-coherent;
			power-domain-names = "ife0\0ife1\0ife2\0top";
			power-domains = <0x15f 0x03 0x15f 0x04 0x15f 0x05 0x15f 0x00>;
			iommus = <0x29 0x1c00 0x00>;
			interconnect-names = "ahb\0hf_mnoc\0sf_mnoc\0sf_icp_mnoc";
			interconnects = <0x2c 0x02 0x03 0x2d 0x03 0x03 0x94 0x00 0x07 0x16 0x01 0x07 0x94 0x03 0x07 0x16 0x01 0x07 0x94 0x01 0x07 0x16 0x01 0x07>;
			interrupt-names = "csid0\0csid1\0csid2\0csid_lite0\0csid_lite1\0csiphy0\0csiphy1\0csiphy2\0csiphy3\0csiphy4\0csiphy5\0vfe0\0vfe1\0vfe2\0vfe_lite0\0vfe_lite1";
