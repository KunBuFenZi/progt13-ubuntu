[Unit]
Description=TB378FC sensor domain file server
ConditionPathIsDirectory=/usr/share/tb378fc/sensors/hexagonrpcd/sensors/registry
ConditionDirectoryNotEmpty=/usr/share/tb378fc/sensors/hexagonrpcd/sensors/registry
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
User=fastrpc
Group=fastrpc
ExecStart=/usr/lib/tb378fc/sensors/bin/hexagonrpcd -f /dev/tb378fc-sensors-fastrpc -d adsp -s -R /usr/share/tb378fc/sensors/hexagonrpcd
Restart=no
TimeoutStopSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
DevicePolicy=closed
DeviceAllow=/dev/tb378fc-sensors-fastrpc rw
