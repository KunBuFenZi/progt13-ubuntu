+	WCD_SDW_CH(WCD939X_DMIC6, WCD939X_DMIC_3_7_PORT, BIT(2)),
+	WCD_SDW_CH(WCD939X_DMIC7, WCD939X_DMIC_3_7_PORT, BIT(3)),
+};
+
+static bool wcd939x_is_tb378fc(void)
+{
+	struct device_node *node;
+	bool found;
+
+	node = of_find_compatible_node(NULL, NULL, "lenovo,tb378fc-pmic-glink");
+	found = !!node;
+	of_node_put(node);
+
+	return found;
+}
 
