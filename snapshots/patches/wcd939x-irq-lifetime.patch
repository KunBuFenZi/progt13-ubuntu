+static void wcd939x_irq_exit(struct wcd939x_priv *wcd, struct device *dev)
+{
+	unsigned int irq;
+	int i;
+
+	if (!wcd->virq)
+		return;
+
+	/* The SDW wrapper holds this lock throughout the nested callback. Clear
+	 * both pointers and wait for any callback before freeing its domain.
+	 * This lock is independent of the SoundWire driver's sdw_dev_lock.
+	 */
+	for (i = 0; i < NUM_CODEC_DAIS; i++) {
+		if (!wcd->sdw_priv[i])
+			continue;
+		mutex_lock(&wcd->sdw_priv[i]->irq_lock);
+		wcd->sdw_priv[i]->slave_irq = NULL;
+		mutex_unlock(&wcd->sdw_priv[i]->irq_lock);
+	}
+
+	irq = irq_find_mapping(wcd->virq, 0);
+	if (wcd->irq_chip) {
+		devm_regmap_del_irq_chip(dev, irq, wcd->irq_chip);
+		wcd->irq_chip = NULL;
+	}
+	if (irq)
+		irq_dispose_mapping(irq);
+	irq_domain_remove(wcd->virq);
+	wcd->virq = NULL;
+}
+
 static int wcd939x_irq_init(struct wcd939x_priv *wcd, struct device *dev)
 {
+	unsigned int irq;
+	int ret;
+
 	wcd->virq = irq_domain_create_linear(NULL, 1, &wcd_domain_ops, NULL);
 	if (!(wcd->virq)) {
 		dev_err(dev, "%s: Failed to add IRQ domain\n", __func__);
 		return -EINVAL;
 	}
 
-	return devm_regmap_add_irq_chip(dev, wcd->regmap,
-					irq_create_mapping(wcd->virq, 0),
-					IRQF_ONESHOT, 0, &wcd939x_regmap_irq_chip,
-					&wcd->irq_chip);
+	irq = irq_create_mapping(wcd->virq, 0);
+	if (!irq) {
+		wcd939x_irq_exit(wcd, dev);
+		return -ENOMEM;
+	}
+	ret = devm_regmap_add_irq_chip(dev, wcd->regmap, irq,
+				       IRQF_ONESHOT, 0, &wcd939x_regmap_irq_chip,
+				       &wcd->irq_chip);
+	if (ret)
+		wcd939x_irq_exit(wcd, dev);
+	return ret;
 }
 
