+/* Native TB378FC sequence decoded from its camera module binary.
+ * Parent supplies and voltage constraints are represented in device tree.
+ */
+static int ov13b10_tb378fc_power_on(struct ov13b10 *sensor)
+{
+	const unsigned int order[] = { 1, 0, 2 }; /* AVDD, DOVDD, DVDD */
+	int ret, i;
+
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	fsleep(1000);
+	ret = regulator_enable(sensor->vaf);
+	if (ret)
+		return ret;
+	fsleep(5000);
+	for (i = 0; i < ARRAY_SIZE(order); i++) {
+		ret = regulator_enable(sensor->supplies[order[i]].consumer);
+		if (ret)
+			goto disable;
+	}
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	fsleep(5000);
+	ret = clk_prepare_enable(sensor->img_clk);
+	if (ret)
+		goto disable;
+	fsleep(1000);
+	return 0;
+
+disable:
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	while (i--)
+		regulator_disable(sensor->supplies[order[i]].consumer);
+	regulator_disable(sensor->vaf);
+	return ret;
+}
+
+static int ov13b10_tb378fc_power_off(struct ov13b10 *sensor)
+{
+	regulator_disable(sensor->vaf);
+	fsleep(5000);
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	fsleep(1000);
+	clk_disable_unprepare(sensor->img_clk);
+	fsleep(1000);
+	regulator_disable(sensor->supplies[2].consumer);
+	regulator_disable(sensor->supplies[0].consumer);
+	regulator_disable(sensor->supplies[1].consumer);
+	return 0;
+}
