# Merge after the proven stage-1 config. Native display bring-up.
CONFIG_LOCALVERSION="-tb378fc-display"
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_TB378FC_NT36526=y
# CONFIG_DRM_PANEL_NOVATEK_NT36536 is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_TB378FC_AW99706B=y
CONFIG_REGULATOR_TB378FC_BIAS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_USB_CONFIGFS_RNDIS=y
