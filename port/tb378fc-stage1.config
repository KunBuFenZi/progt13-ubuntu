# Merge after arm64 defconfig and erhai-firstboot.config.
CONFIG_LOCALVERSION="-tb378fc-stage1"
# Keep optional defconfig drivers modular; the stage-1 build only builds Image.
CONFIG_MODULES=y
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_KEYBOARD_ONEPLUS_POGO is not set
# CONFIG_QCOM_Q6V5_PAS is not set
# CONFIG_QCOM_PMIC_GLINK is not set
# CONFIG_TYPEC is not set
# CONFIG_SQUASHFS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_ETHERNET is not set
# CONFIG_HID is not set
# CONFIG_CPU_FREQ is not set
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BOOT_CONFIG=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
