[Unit]
Description=Tablet backlight-only blanking
Requires=tb378fc-display-power.socket
After=systemd-logind.service
ConditionDirectoryNotEmpty=/sys/class/backlight

[Service]
# Skip, rather than fail, unless exactly one led-backlight device exists.
ExecCondition=/usr/sbin/tb378fc-display-power --check
ExecStart=/usr/sbin/tb378fc-display-power
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/sys/class/backlight
TimeoutStopSec=5
