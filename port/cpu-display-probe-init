#!/bin/sh
export PATH=/bin
(while [ ! -d /run/evidence ]; do sleep 1; done
 sleep 12
 (
  echo CPU_DISPLAY_PROBE_BEGIN
  cat /etc/build-id
  probe() {
      echo "DISPLAY_PHASE=$1"
      cat /proc/uptime
      cat /sys/devices/system/cpu/online
      for p in /sys/devices/system/cpu/cpufreq/policy*; do
          echo "$p"
          cat "$p/scaling_governor" "$p/scaling_cur_freq"
      done
      /bin/kms-test 20
      echo "KMS_EXIT=$?"
      dmesg >"/run/evidence/display-$1.txt"
  }
  probe single_schedutil
  for cpu in 1 2 3 4 5 6 7; do
      echo 1 >"/sys/devices/system/cpu/cpu$cpu/online"
      echo "CPU=$cpu EXIT=$?"
  done
  probe eight_schedutil
  for p in /sys/devices/system/cpu/cpufreq/policy*; do
      echo performance >"$p/scaling_governor"
  done
  probe eight_performance
  echo 0 >/sys/devices/system/cpu/cpu7/online
  probe seven_performance
  echo CPU_DISPLAY_PROBE_DONE
 ) >/run/evidence/cpu-display-probe.txt 2>&1
) &
exec /bin/ram-base-init
