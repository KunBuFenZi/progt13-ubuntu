// SPDX-License-Identifier: BSD-3-Clause
/* Native amp enumeration only: no sound card or automatic playback. */
#include "sm8750-lenovo-tb378fc-battery.dts"

&tlmm {
    tb378fc_amp_resets: amp-resets-state {
        pins = "gpio106", "gpio128", "gpio120", "gpio108";
        function = "gpio";
        drive-strength = <2>;
        bias-disable;
    };
};

/* Never let the hardware GPI controller claim these same lines. */
&i2c5 { status = "disabled"; };

&tlmm {
    tb378fc_gpio_i2c: tb378fc-amp-i2c-state {
        pins = "gpio52", "gpio53";
        function = "gpio";
        drive-strength = <2>;
        bias-pull-up;
    };
};

/ {
    tb378fc_amp_bus: tb378fc-amp-i2c {
    compatible = "i2c-gpio";
    #address-cells = <1>;
    #size-cells = <0>;
    sda-gpios = <&tlmm 52 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    scl-gpios = <&tlmm 53 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    i2c-gpio,delay-us = <5>;
    pinctrl-names = "default";
    pinctrl-0 = <&tb378fc_gpio_i2c>, <&tb378fc_amp_resets>;

    spk_amp1: amplifier@34 {
        compatible = "awinic,aw88480";
        reg = <0x34>;
        #sound-dai-cells = <0>;
        sound-name-prefix = "Amp1";
        awinic,audio-channel = <1>;
        reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
        firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
    };

    spk_amp0: amplifier@35 {
        compatible = "awinic,aw88480";
        reg = <0x35>;
        #sound-dai-cells = <0>;
        sound-name-prefix = "Amp0";
        awinic,audio-channel = <0>;
        reset-gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
        firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
    };

    spk_amp2: amplifier@36 {
        compatible = "awinic,aw88480";
        reg = <0x36>;
        #sound-dai-cells = <0>;
        sound-name-prefix = "Amp2";
        awinic,audio-channel = <2>;
        reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
        firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
    };

    spk_amp3: amplifier@37 {
        compatible = "awinic,aw88480";
        reg = <0x37>;
        #sound-dai-cells = <0>;
        sound-name-prefix = "Amp3";
        awinic,audio-channel = <3>;
        reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
        firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
    };
};
};

// SPDX-License-Identifier: BSD-3-Clause


/ {
    sound {
        compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
        model = "Lenovo-TB378FC";
        widgets = "Speaker", "Speakers";
        audio-routing = "Speakers", "Amp0 OUT",
                        "Speakers", "Amp1 OUT",
                        "Speakers", "Amp2 OUT",
                        "Speakers", "Amp3 OUT";
        pinctrl-names = "default";
        pinctrl-0 = <&tb378fc_sec_tdm>;

        speaker-playback-dai-link {
            link-name = "Speaker Playback";
            dai-format = "dsp_b";
            convert-rate = <48000>;
            convert-channels = <4>;
            convert-sample-format = "s32_le";
            cpu {
                sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
                dai-tdm-slot-num = <4>;
                dai-tdm-slot-width = <32>;
                dai-tdm-slot-rx-mask = <1 1 1 1>;
            };
            codec-0 {
                sound-dai = <&spk_amp0>;
                dai-tdm-slot-tx-mask = <1>;
                dai-tdm-slot-rx-mask = <1>;
                bitclock-inversion;
            };
            codec-1 {
                sound-dai = <&spk_amp1>;
                dai-tdm-slot-tx-mask = <0 1>;
                dai-tdm-slot-rx-mask = <0 1>;
                bitclock-inversion;
            };
            codec-2 {
                sound-dai = <&spk_amp2>;
                dai-tdm-slot-tx-mask = <0 0 1>;
                dai-tdm-slot-rx-mask = <0 0 1>;
                bitclock-inversion;
            };
            codec-3 {
                sound-dai = <&spk_amp3>;
                dai-tdm-slot-tx-mask = <0 0 0 1>;
                dai-tdm-slot-rx-mask = <0 0 0 1>;
                bitclock-inversion;
            };
            platform { sound-dai = <&q6apm>; };
        };
    };
};

&tlmm {
    tb378fc_sec_tdm: secondary-tdm-state {
        sck-pins {
            pins = "gpio121";
            function = "i2s1_sck";
            drive-strength = <8>;
            bias-disable;
        };
        data0-pins {
            pins = "gpio122";
            function = "i2s1_data0";
            drive-strength = <8>;
            bias-disable;
        };
        ws-pins {
            pins = "gpio123";
            function = "i2s1_ws";
            drive-strength = <8>;
            bias-disable;
        };
        data1-pins {
            pins = "gpio124";
            function = "i2s1_data1";
            drive-strength = <8>;
            bias-disable;
        };
    };
};
